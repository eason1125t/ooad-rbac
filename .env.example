# 本地Compose专用，复制为.env并填写；禁止提交.env。宿主Java进程需单独导入这些变量。
DB_URL=jdbc:mysql://127.0.0.1:3307/rbac?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_USERNAME=rbac
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# 仅本机开发显式启用；demo账号目录统一1234，不能与prod组合。生产不使用本示例配置。
